<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <RootNamespace>UTS.Presentation.Wpf</RootNamespace>
    <AssemblyName>UTS.Presentation.Wpf</AssemblyName>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UTS.Application.Contracts\UTS.Application.Contracts.vbproj" />
    <PackageReference Include="OxyPlot.Wpf" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Shell\ShellWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Shell\ShellWindow.xaml.vb">
      <DependentUpon>ShellWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
